{
  "name": "@klixsoft/react-native-esewa",
  "version": "0.1.0",
  "description": "eSewa payments for React Native: the official Intent flow (app-to-app) and ePay v2, with no embedded WebView.",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "CHANGELOG.md",
    "src",
    "android",
    "ios",
    "docs",
    "RNKlixsoftEsewa.podspec",
    "!android/build",
    "!**/__tests__"
  ],
  "keywords": [
    "react-native",
    "esewa",
    "payment",
    "payment-gateway",
    "nepal",
    "epay",
    "intent",
    "deeplink",
    "ios",
    "android",
    "turbomodule"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./__tests__/register.mjs --test __tests__/",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klixsoft/react-native-esewa.git"
  },
  "bugs": {
    "url": "https://github.com/klixsoft/react-native-esewa/issues"
  },
  "homepage": "https://github.com/klixsoft/react-native-esewa#readme",
  "author": "Klixsoft",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "codegenConfig": {
    "name": "RNKlixsoftEsewaSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.klixsoft.esewa"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "typescript": "^5.9.3"
  }
}
